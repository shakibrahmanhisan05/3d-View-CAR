# Copy to .env.local and fill in. The site runs fully with NONE of these set.

# --- Assets (Cloudflare R2 public bucket) -----------------------------------
# When unset, the configurator runs on procedural placeholder geometry (§12.4)
# and posters fall back to an inline SVG. 3D assets are never served from /public.
NEXT_PUBLIC_ASSET_BASE_URL=

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phoenix's own WhatsApp / phone. Country code, digits only, no + and no spaces.
NEXT_PUBLIC_WHATSAPP=8801XXXXXXXXX
NEXT_PUBLIC_PHONE=+8801XXXXXXXXX

# --- Database (Neon Postgres) -------------------------------------------------
# When unset, leads and saved builds are written to ./.data/*.json instead.
DATABASE_URL=

# --- Admin ----------------------------------------------------------------------
# /admin is gated by this single shared password. There is no auth system (§17).
ADMIN_PASSWORD=
